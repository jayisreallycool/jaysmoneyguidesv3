rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ====================================================================
    // SECURITY HELPER FUNCTIONS
    // ====================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && 
        (
          request.auth.token.email.lower() == 'jayisreallycool@gmail.com' ||
          request.auth.token.email.lower() == 'buddhacmd02@gmail.com'
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ====================================================================
    // EBOOK CATALOG (Public Read, Admin Write)
    // ====================================================================
    
    // Source of truth for eBooks: publicly readable product data, admin write only
    match /ebooks/{ebookId} {
      allow read: if true; // Public: anyone can view ebook metadata
      allow write: if isAdmin(); // Only admins can create/update products
      allow delete: if isAdmin();
    }

    // Ebook file records & storage metadata
    match /ebook_files/{fileId} {
      allow read: if true; // Public: anyone can view file metadata
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // ====================================================================
    // PURCHASES & ORDERS (Server-Side Only)
    // ====================================================================
    
    // Purchase records: strictly handled server-side via Firebase Admin SDK
    // Clients CANNOT directly read/write - prevents fraud
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // Purchase history for authenticated users
    match /users/{userId}/purchases/{purchaseId} {
      allow read: if isOwner(userId);
      allow write: if false; // Server-side only
    }

    // ====================================================================
    // MEDIA ASSETS (Public Read, Admin Write)
    // ====================================================================
    
    // Media assets library & infographics
    match /media_assets/{assetId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Video tutorials & masterclasses
    match /video_assets/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ====================================================================
    // CONTENT (Public Read, Admin Write)
    // ====================================================================
    
    // Blog articles & guides
    match /posts/{postId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Article comments: public read and creation, admin moderation
    match /comments/{commentId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }

    // ====================================================================
    // USER DATA (Owner Read/Write, Admin Oversight)
    // ====================================================================
    
    // Registered user profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow create: if isAuthenticated();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ====================================================================
    // NEWSLETTER & CONTACT (Public Write, Admin Read)
    // ====================================================================
    
    // Newsletter subscribers: public submission, admin management
    match /subscribers/{subscriberId} {
      allow create: if true; // Public: anyone can subscribe
      allow read, update, delete: if isAdmin();
    }

    // Contact messages: public submission, admin management
    match /contact_messages/{msgId} {
      allow create: if true; // Public: anyone can submit
      allow read, update, delete: if isAdmin();
    }

    // ====================================================================
    // EBOOK ENTITLEMENTS (Server-Side Write, Owner Read)
    // ====================================================================

    // Entitlements granted after purchase or admin grant — written only via Admin SDK
    match /entitlements/{entitlementId} {
      allow read: if isAuthenticated(); // owner check done in API layer
      allow write: if false; // Server-side only (Admin SDK bypasses rules)
    }

    // ====================================================================
    // REVIEWS (Public Submit, Admin Moderate)
    // ====================================================================

    // User-submitted reviews: public creation as pending, admin moderation
    match /reviews/{reviewId} {
      allow read: if true;                    // Public: approved reviews shown on site
      allow create: if true;                  // Public: anyone can submit (rate-limited in API)
      allow update, delete: if isAdmin();     // Admin only: approve/reject/delete
    }

    // ====================================================================
    // ANALYTICS COUNTERS (Public Write, Admin Read)
    // ====================================================================

    // Article view counters — incremented client-side via FieldValue.increment
    match /article_views/{slug} {
      allow read: if isAdmin();
      allow write: if true;   // Public atomic increments; dedup handled in API layer
    }

    // Ebook page view counters — incremented client-side via FieldValue.increment
    match /ebook_opens/{productId} {
      allow read: if isAdmin();
      allow write: if true;   // Public atomic increments; dedup handled in API layer
    }
  }
}


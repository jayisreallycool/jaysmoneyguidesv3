# ============================================================
# FIREBASE CLIENT CONFIG (public, safe to commit)
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=jaysmoneyguides.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=jaysmoneyguides
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=jaysmoneyguides.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=526143175924
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id_here
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# ============================================================
# GOOGLE OAUTH (secret — NEVER commit actual values)
# ============================================================
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ============================================================
# ADMIN ACCESS KEYS (secret — NEVER commit actual values)
# ============================================================
ADMIN_ACCESS_KEY=your_admin_access_key_here
NEXT_PUBLIC_ADMIN_ACCESS_KEY=your_public_admin_access_key_here

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ============================================================
# FIREBASE SERVICE ACCOUNT (server-side admin, secret)
# ============================================================
FIREBASE_SERVICE_ACCOUNT_KEY=your_firebase_service_account_json_here

# ============================================================
# EMAIL (Gmail SMTP)
# ============================================================
GMAIL_USER=your_gmail_user_here
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# ============================================================
# APP CONFIG
# ============================================================
DOWNLOAD_TOKEN_SECRET=your_download_token_secret_here
SITE_URL=https://www.jaysmoneyguides.com

# ============================================================
# GOOGLE ADSENSE — set after approval to activate all ad units
# ============================================================
# Get your publisher ID from: https://adsense.google.com/start
# Format: ca-pub-XXXXXXXXXXXXXXXX
# Leave unset (or commented out) until approved — zero performance cost when unset.
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
#
# After setting the client ID, replace the slot placeholders in:
#   app/guide/[slug]/page.tsx   → GUIDE_TOP_LEADERBOARD, GUIDE_MID_RECTANGLE, GUIDE_BOTTOM_LEADERBOARD
#   components/client/HomeClient.tsx → HOME_MID_LEADERBOARD
# with the numeric slot IDs from your AdSense ad units dashboard.
